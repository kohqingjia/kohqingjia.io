---
// OWNER: shared. Claude: sections, order, data. Codex: everything visual,
// including the hero set piece and the scroll-drawn line (src/components/visual/).
import Base from '../layouts/Base.astro';
import Station from '../components/Station.astro';
import RouteAtlas from '../components/visual/RouteAtlas.astro';
import RouteTrack from '../components/visual/RouteTrack.astro';
import { site } from '../data/site';
import { featuredProjects } from '../data/projects';

const featured = await featuredProjects();
const building = featured.filter((p) => p.data.status === 'building');
const shipped = featured.filter((p) => p.data.status !== 'building');
---
<Base>
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <p class="hero__index eyebrow"><span>QJ / Personal route atlas</span><span>{site.location}</span></p>
    <div class="hero__copy">
    <h1 id="hero-title" class="hero__title">{site.name}</h1>
    <p class="hero__role">{site.role}</p>
    <p class="hero__intro">{site.intro}</p>
    <p class="hero__actions">
      <a class="button button--primary" href="#line">See the work</a>
      <a class="button button--quiet" href={site.links.github} rel="me">GitHub</a>
    </p>
    </div>
    <RouteAtlas />
    <p class="hero__foot eyebrow"><span>Ideas, experiments, useful things</span><a href="#line">Follow the line <span aria-hidden="true">↓</span></a></p>
  </section>

  <div class="line" id="line" data-line>
    <div class="line__intro"><p class="eyebrow">Selected stops</p><p class="eyebrow">{String(featured.length).padStart(2, '0')} projects along the way</p></div>
    <section class="line__section" aria-labelledby="building-title" data-segment="building">
      <RouteTrack />
      <h2 id="building-title" class="line__heading">Building now</h2>
      <ol class="line__stations" role="list">
        {building.map((p, i) => <li><Station project={p} index={i} /></li>)}
      </ol>
    </section>

    <section class="line__section" aria-labelledby="shipped-title" data-segment="shipped">
      <RouteTrack />
      <h2 id="shipped-title" class="line__heading">Shipped</h2>
      <ol class="line__stations" role="list">
        {shipped.map((p, i) => <li><Station project={p} index={building.length + i} /></li>)}
      </ol>
    </section>

    <p class="line__end"><span class="eyebrow">There are more stops on this line</span><a class="button" href="/projects">Every project <span aria-hidden="true">↗</span></a></p>
  </div>
</Base>
