---
// OWNER: shared. kohqingjia.io/<slug> — one page per project.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import { allProjects, period, RESERVED_SLUGS, type Project } from '../data/projects';
import { statusLabel } from '../data/site';

export const getStaticPaths = (async () => {
  const all = await allProjects();
  for (const p of all) {
    if (RESERVED_SLUGS.has(p.id)) throw new Error(`Project slug "${p.id}" clashes with a reserved route`);
  }
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[i - 1], next: all[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props { project: Project; prev?: Project; next?: Project }
const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---
<Base title={d.title} description={d.tagline}>
  <article class="project" data-status={d.status} data-kind={d.kind}>
    <header class="project__head">
      <Sprite file={d.sprite} slug={project.id} size="lg" />
      <p class="project__meta">
        <span class="station__status" data-status={d.status}>{statusLabel[d.status]}</span>
        <span>{period(project)}</span>
        {d.team && <span>Team of {d.team}</span>}
      </p>
      <h1 class="project__title">{d.title}</h1>
      <p class="project__tagline">{d.tagline}</p>
      <p class="project__role">{d.role}{d.org && <> · {d.org}</>}</p>
      {d.links.length > 0 && (
        <ul class="project__links" role="list">
          {d.links.map((l) => (
            <li><a href={l.href} data-link-kind={l.kind} rel="noopener">{l.label}</a></li>
          ))}
        </ul>
      )}
    </header>

    <div class="project__content prose">
      <Content />
    </div>

    {d.stack.length > 0 && (
      <section class="project__stack" aria-label="Built with">
        <h2>Built with</h2>
        <ul role="list">{d.stack.map((s) => <li>{s}</li>)}</ul>
      </section>
    )}

    <nav class="project__pager" aria-label="More projects">
      {prev && <a rel="prev" href={`/${prev.id}`}>{prev.data.title}</a>}
      <a href="/projects">All projects</a>
      {next && <a rel="next" href={`/${next.id}`}>{next.data.title}</a>}
    </nav>
  </article>
</Base>
