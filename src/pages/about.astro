---
// OWNER: shared. Copy is a DRAFT for QJ to rewrite in their own voice.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About">
  <article class="about prose">
    <h1>About</h1>
    <p>I'm {site.name}, an {site.role}, based in {site.location}.</p>
    <p>I've worked as an agentic AI engineering intern at treatsure and as an AI and agentic developer at Promyro. I've also been a teaching assistant at SMU for a class of more than 40 students.</p>
    <p>I'm looking for product, data and AI engineering roles. <a href={site.links.resume}>Read my résumé</a> or find me on <a href={site.links.linkedin} rel="me">LinkedIn</a>.</p>
  </article>
</Base>
