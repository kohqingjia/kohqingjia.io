---
// OWNER: shared. Claude: responsive image pipeline + semantics.
// Codex: frame treatment (browser chrome, device bezel, lightbox) via classes.
// Every shot links to its full-size original so it can be opened large without JS.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** cover = big hero shot; gallery = grid item; thumb = small card preview */
  variant?: 'cover' | 'gallery' | 'thumb';
  eager?: boolean;
}
const { src, alt, caption, variant = 'gallery', eager = false } = Astro.props;
const widths = {
  cover: [640, 960, 1280, 1920],
  gallery: [480, 720, 960, 1440],
  thumb: [320, 480, 640],
}[variant];
const sizes = {
  cover: '(min-width: 1200px) 1120px, 100vw',
  gallery: '(min-width: 900px) 50vw, 100vw',
  thumb: '(min-width: 900px) 320px, 100vw',
}[variant];
const full = variant === 'thumb' ? null : await getImage({ src, format: 'webp', width: Math.min(src.width, 2560) });
const isMobile = src.height > src.width;
---
<figure class={`shot shot--${variant}`} data-shot={variant} data-orientation={isMobile ? 'portrait' : 'landscape'}>
  {full ? (
    <a class="shot__frame" href={full.src} aria-label={`Open full-size image: ${alt}`}>
      <Picture src={src} alt={alt} widths={widths.filter((w) => w <= src.width)} sizes={sizes}
        formats={['avif', 'webp']} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    </a>
  ) : (
    <div class="shot__frame">
      <Picture src={src} alt={alt} widths={widths.filter((w) => w <= src.width)} sizes={sizes}
        formats={['avif', 'webp']} loading="lazy" />
    </div>
  )}
  {caption && <figcaption class="shot__caption">{caption}</figcaption>}
</figure>
