---
// OWNER: shared. Claude owns the data wiring + semantics; Codex owns classes,
// visual markup and the sprite treatment. Keep: the <article>, the heading,
// the link to /{id}, and the data-* hooks (motion.css + tests rely on them).
import type { Project } from '../data/projects';
import { period } from '../data/projects';
import { statusLabel } from '../data/site';
import Sprite from './Sprite.astro';
import Shot from './Shot.astro';

interface Props {
  project: Project; index: number; headingLevel?: 'h2' | 'h3';
  /** Codex: set true once .station__preview is styled. */
  preview?: boolean;
}
const { project, index, headingLevel: H = 'h3', preview = false } = Astro.props;
const d = project.data;
---
<article
  class="station"
  data-station
  data-status={d.status}
  data-kind={d.kind}
  style={`--i:${index}`}
>
  <Sprite file={d.sprite} slug={project.id} />
  <div class="station__body">
    <p class="station__meta">
      <span class="station__status" data-status={d.status}>{statusLabel[d.status]}</span>
      <span class="station__period">{period(project)}</span>
    </p>
    <H class="station__title">
      <a href={`/${project.id}`}>{d.title}</a>
    </H>
    <p class="station__tagline">{d.tagline}</p>
    <p class="station__role">{d.role}{d.org && <> · {d.org}</>}</p>
  </div>
  {preview && d.cover && (
    <div class="station__preview" data-preview aria-hidden="true">
      <Shot src={d.cover.src} alt="" variant="thumb" />
    </div>
  )}
</article>
