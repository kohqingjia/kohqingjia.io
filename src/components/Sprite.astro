---
// OWNER: Codex (visual). Claude's stub: renders /sprites/<file> with a
// view-transition-name so the sprite morphs between list and project page.
import fs from 'node:fs';
import path from 'node:path';

interface Props { file: string; slug: string; size?: 'sm' | 'lg' }
const { file, slug, size = 'sm' } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), 'public', 'sprites', file));
const src = `/sprites/${exists ? file : 'placeholder.svg'}`;
---
<img
  class={`sprite sprite--${size}`}
  src={src}
  alt=""
  width="64"
  height="64"
  loading="lazy"
  decoding="async"
  style={`view-transition-name: sprite-${slug}`}
/>
