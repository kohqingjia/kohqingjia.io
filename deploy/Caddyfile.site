# Inner server (inside the kohqingjia-site container). TLS is handled by the
# VPS's main Caddy (~/stardyhub/Caddyfile), which reverse-proxies here.
:80 {
	root * /srv
	encode zstd gzip
	# Vite's hashed bundles and versioned font files never change: cache for a year.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Sprites and share images keep their names when edited: cache for a day.
	@daily path /sprites/* /og/* /icons/*
	header @daily Cache-Control "public, max-age=86400"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Stable résumé links (302 so the PDF filename can change later)
	redir /cv /KohQingJia_Resume.pdf 302
	redir /cv/ /KohQingJia_Resume.pdf 302
	redir /resume /KohQingJia_Resume.pdf 302
	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
